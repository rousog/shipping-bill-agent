# ============================================================
# 所有敏感信息只放 .env；.env 已被 .gitignore 忽略，不会进 Git。
# 复制本文件为 .env 后填写。
# ============================================================

# ---------- LLM ----------
# 火山方舟 Ark 是 OpenAI 兼容接口
LLM_PROVIDER=openai
# 填你的 Ark 推理接入点 ID（通常以 ep- 开头）或模型名
LLM_MODEL=your-ark-endpoint-id
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_TEMPERATURE=0

# ---------- OCR ----------
OCR_URL=http://36.103.199.11:5002/process
OCR_TASK=orderChange
OCR_TIMEOUT_CONNECT=10
OCR_TIMEOUT_READ=300
OCR_MAX_RETRIES=3
# 可选：OCR 服务访问文件的公网 URL 前缀。
# 如果 ASSET_PUBLIC_BASE_URL 为空，会回退使用这个。
# 必须指向 ASSET_ROOT（默认 data/assets）这一层。
OCR_PUBLIC_BASE_URL=

# ---------- 记账主体 ----------
ACCOUNTING_ENTITY=湃乐多（上海）航运科技有限公司
# 多个别名用分号分隔；注意公司名里可能有逗号
ACCOUNTING_ENTITY_ALIASES=湃乐多;Pilot Aiship Tech co., Ltd.;PLTP

# AR/AP 策略：
# hybrid    = LLM 候选 + 代码规则；规则判不了时采用 LLM，冲突才挂起（默认）
# llm_first = 优先采用 LLM 候选，代码只检查冲突
# rule_first= 只信代码规则，LLM 候选无法验证时挂起
AR_AP_POLICY=hybrid

# ---------- 存储 ----------
DB_PATH=data/agent.db
ASSET_ROOT=data/assets
ASSET_BACKEND=local
# 可选：资产库公网 URL 前缀，优先级高于 OCR_PUBLIC_BASE_URL。
# LocalAssetStore.url() 返回 {ASSET_PUBLIC_BASE_URL}/{storage_key}
# 例如 storage_key=fa/fad.../original.pdf
#   -> https://xxx.trycloudflare.com/fa/fad.../original.pdf
ASSET_PUBLIC_BASE_URL=

# ---------- 运行时 ----------
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.6
MAX_RETRIES=3
